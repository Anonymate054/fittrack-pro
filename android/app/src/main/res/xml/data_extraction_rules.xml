<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye todos los datos de la app (incluido el almacenamiento del WebView
     con mediciones de salud) del respaldo en la nube y de la transferencia entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
